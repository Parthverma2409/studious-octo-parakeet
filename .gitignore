# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Build artefacts. Regenerated by `python -m packages.bench --all
# --dump-trajectories data/trajectories` and `python dashboard/build_index.py`.
# The test suite generates them itself (tests/conftest.py), so a fresh clone
# needs no setup step.
data/trajectories/
data/nlu/splits/
dashboard/data/

# Course reference documents. Kept locally for the team, not redistributed:
# they are coursework submissions, not part of the software.
docs/*.pdf
docs/*.docx

# Real data. Never committed.
#   data/private/  - redacted real email used for validation
#   data/gold/labels.jsonl - collected human labels (see data/gold/README.md)
#   data/nlu/real/ - licensed or exported corpora
data/private/
data/gold/labels.jsonl
data/nlu/real/
*.mbox

# Secrets. An OAuth token grants access to a real calendar and inbox.
*.env
.env
credentials.json
client_secret*.json
token.json
tokens.enc
*.key
